PORT=4173
DATABASE_PATH=./data/jarvis.db
# Required in production. Store these as host secrets, never in this file.
JARVIS_OWNER_USERNAME=your-private-username
JARVIS_OWNER_PASSWORD=replace-with-a-unique-password-of-at-least-10-characters
# Future integration only. Empty server-side examples; no adapter reads these yet.
GROQ_API_KEY=
FISH_API_KEY=
# Optional exact public origin (scheme + host + port, no path). Never a secret.
# If unset, requests must match https://Host in production (proxy preserves Host).
JARVIS_ORIGIN=
